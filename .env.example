# Used by docker-compose.yml for the api container. Copy to .env and adjust.
# Use a long random string (min 32 chars), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-0123456789
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
# Public Rick & Morty GraphQL endpoint the API proxies (no auth required)
RICK_MORTY_GRAPHQL_URL=https://rickandmortyapi.com/graphql
